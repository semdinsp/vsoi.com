<.nav_header />

<!-- Hero Section -->
<div class="bg-gradient-to-br from-green-50 to-emerald-100 text-gray-900 py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h1 class="text-5xl font-bold mb-6">Our Vision & Mission</h1>
    <p class="text-xl opacity-90 max-w-4xl mx-auto">
      Building a sustainable future through organic agriculture, community empowerment, and environmental stewardship in Timor Leste and beyond.
    </p>
  </div>
</div>

<!-- Vision & Mission Cards -->
<div class="py-16 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Vision Card -->
    <div class="bg-white rounded-2xl shadow-xl overflow-hidden mb-12 hover:shadow-2xl transition-shadow">
      <div class="md:flex">
        <div class="md:flex-shrink-0">
          <img class="h-64 w-full object-cover md:w-80" src="images/healthy.jpg" alt="Organic farming vision">
        </div>
        <div class="p-8 md:p-12">
          <div class="flex items-center mb-6">
            <span class="hero-eye text-primary text-3xl mr-4"></span>
            <h2 class="text-3xl font-bold text-gray-900">Our Vision</h2>
          </div>
          <p class="text-lg text-gray-700 leading-relaxed">
            To provide the <strong>highest quality organic</strong>, fresh, and locally produced food for our customers, while promoting smart sustainable farming practices and supporting local communities. We envision a world where healthy, organic food is accessible to all, and where farming practices restore rather than deplete our natural environment.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <span class="inline-block bg-green-100 text-green-800 px-3 py-1 rounded-full text-sm font-medium">Premium Quality</span>
            <span class="inline-block bg-emerald-100 text-emerald-800 px-3 py-1 rounded-full text-sm font-medium">Locally Sourced</span>
            <span class="inline-block bg-purple-100 text-purple-800 px-3 py-1 rounded-full text-sm font-medium">Community Focused</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Mission Card -->
    <div class="bg-white rounded-2xl shadow-xl overflow-hidden mb-12 hover:shadow-2xl transition-shadow">
      <div class="md:flex md:flex-row-reverse">
        <div class="md:flex-shrink-0">
          <img class="h-64 w-full object-cover md:w-80" src="images/happy-team.jpg" alt="Team mission">
        </div>
        <div class="p-8 md:p-12">
          <div class="flex items-center mb-6">
            <span class="hero-target text-primary text-3xl mr-4"></span>
            <h2 class="text-3xl font-bold text-gray-900">Our Mission</h2>
          </div>
          <p class="text-lg text-gray-700 leading-relaxed">
            To create a <strong>sustainable food system</strong> in Timor Leste and beyond by producing certified organic farmed products while supporting local farmers with smart farming technology and educating our customers about the benefits of organic food. We are committed to environmental stewardship, social responsibility, and economic empowerment.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <span class="inline-block bg-orange-100 text-orange-800 px-3 py-1 rounded-full text-sm font-medium">Smart Technology</span>
            <span class="inline-block bg-teal-100 text-teal-800 px-3 py-1 rounded-full text-sm font-medium">Farmer Support</span>
            <span class="inline-block bg-emerald-100 text-emerald-800 px-3 py-1 rounded-full text-sm font-medium">Education</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Core Values -->
    <div class="bg-primary text-white rounded-2xl p-8 md:p-12">
      <h2 class="text-3xl font-bold text-center mb-12">Our Core Values</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">

        <div class="text-center">
          <div class="w-20 h-20 bg-white bg-opacity-20 rounded-full mx-auto mb-4 flex items-center justify-center">
            <span class="hero-leaf text-white text-3xl"></span>
          </div>
          <h3 class="font-bold text-xl mb-3">Sustainability</h3>
          <p class="opacity-90">Farming practices that regenerate soil health and protect biodiversity for future generations.</p>
        </div>

        <div class="text-center">
          <div class="w-20 h-20 bg-white bg-opacity-20 rounded-full mx-auto mb-4 flex items-center justify-center">
            <span class="hero-shield-check text-white text-3xl"></span>
          </div>
          <h3 class="font-bold text-xl mb-3">Quality</h3>
          <p class="opacity-90">Uncompromising standards in organic certification, freshness, and nutritional value.</p>
        </div>

        <div class="text-center">
          <div class="w-20 h-20 bg-white bg-opacity-20 rounded-full mx-auto mb-4 flex items-center justify-center">
            <span class="hero-users text-white text-3xl"></span>
          </div>
          <h3 class="font-bold text-xl mb-3">Community</h3>
          <p class="opacity-90">Empowering local farmers and strengthening communities through fair partnerships.</p>
        </div>

        <div class="text-center">
          <div class="w-20 h-20 bg-white bg-opacity-20 rounded-full mx-auto mb-4 flex items-center justify-center">
            <span class="hero-light-bulb text-white text-3xl"></span>
          </div>
          <h3 class="font-bold text-xl mb-3">Innovation</h3>
          <p class="opacity-90">Integrating smart farming technology with traditional knowledge for optimal results.</p>
        </div>

      </div>
    </div>

    <!-- Impact Goals -->
    <div class="mt-16 text-center">
      <h2 class="text-3xl font-bold text-gray-900 mb-12">Our Impact Goals</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

        <div class="bg-white p-6 rounded-lg shadow-md">
          <div class="text-4xl font-bold text-primary mb-2">100%</div>
          <div class="text-lg font-medium text-gray-900 mb-2">Organic Certified</div>
          <p class="text-gray-600">All our products meet strict organic standards without compromise</p>
        </div>

        <div class="bg-white p-6 rounded-lg shadow-md">
          <div class="text-4xl font-bold text-success mb-2">50+</div>
          <div class="text-lg font-medium text-gray-900 mb-2">Local Farmers</div>
          <p class="text-gray-600">Supporting farming families throughout Timor Leste</p>
        </div>

        <div class="bg-white p-6 rounded-lg shadow-md">
          <div class="text-4xl font-bold text-info mb-2">Zero</div>
          <div class="text-lg font-medium text-gray-900 mb-2">Chemical Impact</div>
          <p class="text-gray-600">Protecting soil, water, and biodiversity through natural farming</p>
        </div>

      </div>
    </div>

    <!-- Call to Action -->
    <div class="mt-16 text-center">
      <h3 class="text-2xl font-bold text-gray-900 mb-6">Join Us in Building a Sustainable Future</h3>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/products" class="btn btn-primary btn-lg">
          <.icon name="hero-shopping-cart" class="h-5 w-5 mr-2" />
          Shop Organic Products
        </a>
        <a href="/team" class="btn btn-outline btn-lg">
          <.icon name="hero-user-group" class="h-5 w-5 mr-2" />
          Meet Our Team
        </a>
      </div>
    </div>

  </div>
</div>