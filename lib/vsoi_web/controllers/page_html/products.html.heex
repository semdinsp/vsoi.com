
<.nav_header />

<!-- Hero Section -->
<div class="bg-gradient-to-br from-green-50 to-emerald-100 text-gray-900 py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h1 class="text-4xl font-bold mb-4">Premium Organic Produce</h1>
    <p class="text-xl opacity-90 max-w-3xl mx-auto">
      VSOI is your premier supplier of certified organic fruits and vegetables, grown with care in the rich soil of Timor Leste using sustainable farming practices.
    </p>
  </div>
</div>

<!-- Products Section -->
<div class="py-16 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Fruits Section -->
    <div class="mb-16">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-4 flex items-center justify-center">
          <span class="hero-heart text-red-500 mr-3"></span>
          Fresh Organic Fruits
        </h2>
        <p class="text-lg text-gray-600">Naturally sweet, nutrient-rich fruits grown without chemicals</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-8">
        <!-- Watermelon -->
        <div class="bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
          <div class="bg-[url('/images/amaraf1.jpg')] bg-cover bg-center h-48"></div>
          <div class="p-6">
            <h3 class="font-bold text-xl text-gray-900 mb-3">Amara F1 Watermelon</h3>
            <div class="mb-4">
              <span class="inline-block bg-green-100 text-green-800 text-xs px-2 py-1 rounded-full mb-2">Organic Certified</span>
              <span class="inline-block bg-emerald-100 text-emerald-800 text-xs px-2 py-1 rounded-full mb-2 ml-1">Seedless</span>
            </div>
            <p class="text-gray-600 mb-4">
              Perfectly globular fruits with smooth surfaces and sweet, juicy red flesh. Grown naturally in optimal 12-15°C conditions with smart irrigation technology. Each fruit weighs 6-8kg consistently.
            </p>
            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-3">
              <span class="text-xl sm:text-2xl font-bold text-primary">Contact for Price</span>
              <a href="mailto:sales.vsoi.tl@gmail.com?subject=Watermelon Order Inquiry"
                 class="btn btn-primary w-full sm:w-auto">
                <.icon name="hero-envelope" class="h-4 w-4 mr-2" />
                Order Now
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Vegetables Section -->
