<.flash_group flash={@flash} />

<!-- Hero Section -->
<div class="relative overflow-hidden bg-gradient-to-br from-green-50 to-emerald-100">
  <div class="absolute inset-0 bg-[url('/images/organic-bg.jpg')] bg-cover bg-center opacity-20"></div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
    <div class="text-center">
      <h1 class="text-4xl sm:text-6xl font-bold text-gray-900 mb-6">
        Fresh, Organic &
        <span class="text-primary">Naturally Grown</span>
      </h1>
      <p class="text-xl text-gray-600 mb-8 max-w-3xl mx-auto">
        Verde Smart Organiku International delivers the finest organic fruits and vegetables from our sustainable farms in Timor Leste, bringing you farm-fresh nutrition with every harvest.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/products" class="btn btn-primary btn-lg">
          <.icon name="hero-leaf" class="h-5 w-5 mr-2" />
          Shop Our Products
        </a>
        <a href="/vision" class="btn btn-outline btn-lg">
          <.icon name="hero-arrow-trending-up" class="h-5 w-5 mr-2" />
          Our Mission
        </a>
      </div>
    </div>
  </div>
</div>

<!-- Features Section -->
<div class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-gray-900 mb-4">Why Choose VSOI?</h2>
      <p class="text-lg text-gray-600">Committed to quality, sustainability, and community</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Feature 1 -->
      <div class="text-center p-6 rounded-lg bg-green-50 hover:bg-green-100 transition-colors">
        <div class="w-16 h-16 bg-primary rounded-full mx-auto mb-4 flex items-center justify-center">
          <span class="hero-sparkles text-white text-2xl"></span>
        </div>
        <h3 class="text-xl font-semibold text-gray-900 mb-2">100% Organic</h3>
        <p class="text-gray-600">No chemicals, no GMOs. Just pure, natural goodness grown with sustainable farming practices.</p>
      </div>

      <!-- Feature 2 -->
      <div class="text-center p-6 rounded-lg bg-emerald-50 hover:bg-emerald-100 transition-colors">
        <div class="w-16 h-16 bg-primary rounded-full mx-auto mb-4 flex items-center justify-center">
          <span class="hero-map-pin text-white text-2xl"></span>
        </div>
        <h3 class="text-xl font-semibold text-gray-900 mb-2">Locally Sourced</h3>
        <p class="text-gray-600">Fresh from our farms in Lospalos, Timor Leste. Supporting local communities and reducing food miles.</p>
      </div>

      <!-- Feature 3 -->
      <div class="text-center p-6 rounded-lg bg-orange-50 hover:bg-orange-100 transition-colors">
        <div class="w-16 h-16 bg-warning rounded-full mx-auto mb-4 flex items-center justify-center">
          <span class="hero-heart text-white text-2xl"></span>
        </div>
        <h3 class="text-xl font-semibold text-gray-900 mb-2">Health Focused</h3>
        <p class="text-gray-600">Nutrient-rich produce that supports your health and wellbeing. Taste the difference quality makes.</p>
      </div>
    </div>
  </div>
</div>

<!-- CTA Section -->
<div class="bg-primary text-white py-16">
  <div class="max-w-4xl mx-auto text-center px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl font-bold mb-4">Ready to Experience Fresh?</h2>
    <p class="text-xl mb-8 opacity-90">
      Join our growing community of health-conscious customers who trust VSOI for their organic produce needs.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href="/products" class="btn btn-secondary btn-lg">
        <.icon name="hero-shopping-bag" class="h-5 w-5 mr-2" />
        Browse Products
      </a>
      <a href="/team" class="btn btn-outline btn-lg text-white border-white hover:bg-white hover:text-primary">
        <.icon name="hero-user-group" class="h-5 w-5 mr-2" />
        Meet Our Team
      </a>
    </div>
  </div>
</div>
